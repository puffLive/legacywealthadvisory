# Email Configuration (SMTP)
# For Gmail: Enable 2-factor authentication and create an App Password
# For Office 365: Use your email and password
# For other providers: Check their SMTP settings documentation

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@legacywealthadvisory.ca

# Alternative for Office 365/Outlook
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=damian@legacywealthadvisory.ca
# SMTP_PASSWORD=your-password

# Zoho CRM Configuration (Optional)
# To get these credentials:
# 1. IMPORTANT: First check your Zoho CRM URL to determine your data center:
#    - If crm.zoho.com → Use https://api-console.zoho.com/
#    - If crm.zoho.ca → Use https://api-console.zoho.ca/
#    - If crm.zoho.eu → Use https://api-console.zoho.eu/
#    - If crm.zoho.in → Use https://api-console.zoho.in/
#    - If crm.zoho.com.au → Use https://api-console.zoho.com.au/
# 2. Create a new Client (Server-based Application)
# 3. Add the redirect URL: http://localhost:3000/zoho-callback
# 4. Generate the refresh token using the authorization flow (use matching regional OAuth URL)
# 5. Note: Custom fields in Zoho CRM may need to be created for Service_Interest, Net_Worth, Timeframe, etc.

ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token

# Calendly Configuration (already in use)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/planningwithdamian/30-min-with-damian